# JWT配置（必改）
JWT_SECRET=your_jwt_secret_here

# Telegram配置
TELEGRAM_BASE_URL=https://t.me/s

# Telegram频道配置（保留原生TG搜索；PanSou搜索不受此配置影响）
TELE_CHANNELS=[{"id":"Channel_Shares_115","name":"115分享"},{"id":"Lsp115","name":"115资源分享"},{"id":"regeng115","name":"115影视热更"},{"id":"vip115hot","name":"懒狗115"},{"id":"gimy115iso","name":"剧迷115原盘"}]

# PanSou 搜索服务地址（docker-compose 内服务名）
PANSOU_BASE_URL=http://pansou:8888

# PanSou 启用的网盘类型（逗号分隔）
# 支持：baidu, aliyun, quark, guangya, tianyi, uc, mobile, 115, pikpak, xunlei, 123, magnet, ed2k
PANSOU_CLOUD_TYPES=baidu,aliyun,quark,115,xunlei,pikpak,123,magnet,ed2k

# TMDB 榜单 API 密钥（https://www.themoviedb.org/settings/api 申请）
TMDB_API_KEY=
# TMDB API 基础地址（国内可改成代理地址）
TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB 图片基础地址
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# TMDB 语言（zh-CN / en-US 等）
TMDB_LANGUAGE=zh-CN


# OneStrm 联动配置（也可在管理员设置页配置）
ONESTRM_BASE_URL=http://8.133.190.156:58003
ONESTRM_WEBHOOK_TOKEN=
ONESTRM_SCAN_PATH=/emby
ONESTRM_AUTO_TRIGGER=false
